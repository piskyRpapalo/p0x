#!/usr/bin/env bash
# cc-local · arranca Claude Code contra el CEREBRO LOCAL del nodo.
#
# Bloque 12 (2026-08-04). Script y no alias a propósito: un alias no se versiona,
# no se audita y no puede hacer preflight. Esto sí.
#
# El Soberano lo copia a ~/bin/cc-local (el repo no se auto-instala — IronClaw).
#
# EL METAL (medido el 2026-08-04, no decretado):
#   El cerebro local NO es Ollama — Ollama está parado y deshabilitado. Es un
#   llama-server levantado por deploy/soberano/cerebro-local-arranca.sh, que
#   habla la Anthropic Messages API de forma NATIVA (POST /v1/messages). Por eso
#   no hace falta traductor ni LiteLLM: el arnés apunta ahí directamente.
#
#   El servidor es EFÍMERO: no hay unidad de systemd que lo resucite. Si muere,
#   este envoltorio aborta en el preflight y apunta al script de arranque
#   (deploy/soberano/cerebro-local-arranca.sh), que fija la invocación exacta.
#
#   No hay registro de modelos: hay UN servidor con UN modelo en RAM. Por eso el
#   campo "model" del payload es irrelevante y va fijo a "local".
#
# ---------------------------------------------------------------------------
# NOTA sobre CLAUDE_CODE_ATTRIBUTION_HEADER (documentada, NO activada):
#   Algunos backends OSS pierden el prefix caching porque el arnés inyecta por
#   petición una cabecera con un hash variable; al cambiar el prefijo en cada
#   llamada, la caché del servidor no acierta nunca y el prompt se reevalúa
#   entero. Si eso pasara aquí, se recupera con:
#       export CLAUDE_CODE_ATTRIBUTION_HEADER=0
#   NO se activa por defecto: se activa SOLO si se MIDE degradación.
#   DATO (2026-08-04): en este servidor el prefix caching FUNCIONA — entre
#   corridas idénticas, input_tokens cayó de 32 a 1. O sea que hay caché real
#   que perder: el footgun es aplicable aquí, y merece vigilarse.
# ---------------------------------------------------------------------------
set -euo pipefail

# Desde 2026-08-04 el cerebro local se expone a la TAILNET (autorizado), en el
# 8081 — el 8080 del tailnet lo ocupa open-webui. La IP se resuelve en runtime,
# nunca se escribe aquí: cero IPs en nada versionado. Si no hay tailnet, cae a
# loopback, que sigue funcionando desde este mismo nodo.
P0X_PUERTO_LOCAL="${P0X_PUERTO_LOCAL:-8081}"
_TSIP="$(tailscale ip -4 2>/dev/null | head -1)"
BASE="${P0X_LOCAL_URL:-http://${_TSIP:-127.0.0.1}:$P0X_PUERTO_LOCAL}"
MODELO="local"     # no hay registro que consultar; el servidor sirve lo que tiene cargado.

RELANZA="${P0X_ARRANQUE:-$HOME/p0x/deploy/soberano/cerebro-local-arranca.sh}"

# --- Preflight: UNA sola condición de aborto (honest sensors) --------------
# El servidor es efímero. Si no responde, se dice AHORA, no después de que la
# sesión haya arrancado y el primer turno falle.
if ! HEALTH="$(curl -s -f -m 5 "$BASE/health" 2>/dev/null)" \
   || [ "$(printf '%s' "$HEALTH" | jq -r '.status // "?"' 2>/dev/null)" != "ok" ]; then
  printf '\n  ABORTA · el cerebro local no responde en %s/health\n\n' "$BASE" >&2
  printf '  El servidor es EFÍMERO (no hay unidad que lo resucite). Relánzalo con:\n\n' >&2
  printf '    %s\n\n' "$RELANZA" >&2
  exit 1
fi

# Metadatos SOLO informativos para el banner. Nunca abortan: si el servidor no
# los expone, se muestra NO DATA en vez de inventar una cifra.
META="$(curl -s -m 5 "$BASE/v1/models" 2>/dev/null || true)"
NUM_CTX="$(printf '%s' "$META" | jq -r '.data[0].meta.n_ctx // empty' 2>/dev/null || true)"
NPARAM="$(printf '%s' "$META" | jq -r '.data[0].meta.n_params // empty' 2>/dev/null || true)"
MODELO_REAL="$(printf '%s' "$META" | jq -r '.data[0].id // empty' 2>/dev/null | xargs -r basename 2>/dev/null || true)"

# Backend REAL, leído del proceso que sirve — no una cadena escrita a mano que
# se queda mintiendo cuando el arranque cambia (pasó: el banner decía "CPU pura"
# un día después de que el nodo pasara a Vulkan). Honest sensors sobre el arnés.
BACKEND="NO DATA"
SRV_PID="$(pgrep -f 'llama-server.*--port' 2>/dev/null | head -1 || true)"
if [ -n "$SRV_PID" ] && [ -r "/proc/$SRV_PID/cmdline" ]; then
  SRV_NGL="$(tr '\0' '\n' < "/proc/$SRV_PID/cmdline" | grep -A1 -x -- '-ngl' | tail -1 || true)"
  if tr '\0' '\n' < "/proc/$SRV_PID/environ" 2>/dev/null | grep -qi 'GGML_BACKEND_PATH=.*vulkan'; then
    BACKEND="Vulkan (Radeon 780M), ngl=${SRV_NGL:-?}"
  elif [ "${SRV_NGL:-0}" = "0" ]; then
    BACKEND="CPU pura (-ngl 0)"
  else
    BACKEND="ngl=${SRV_NGL:-?}, backend sin declarar"
  fi
fi
# Sin '·' ni otros multibyte en lo interpolado: printf pad a bytes, no a columnas,
# y un multibyte descuadra la caja del banner.
if [ -n "$NUM_CTX" ]; then
  CTX_TXT="$NUM_CTX (flag -c del arranque)"
else
  CTX_TXT="NO DATA"
fi
if [ -n "$NPARAM" ]; then
  MODELO_TXT="$(awk -v n="$NPARAM" -v m="${MODELO_REAL:-$MODELO}" 'BEGIN{printf "%.28s (%.1fB)", m, n/1e9}')"
else
  MODELO_TXT="$MODELO (NO DATA)"
fi

# --- Reapuntado total del arnés -------------------------------------------
export ANTHROPIC_BASE_URL="$BASE"
export ANTHROPIC_AUTH_TOKEN="placeholder-local-no-frontier"   # el servidor no valida; el arnés exige que exista.
export ANTHROPIC_MODEL="$MODELO"
export ANTHROPIC_DEFAULT_OPUS_MODEL="$MODELO"
export ANTHROPIC_DEFAULT_SONNET_MODEL="$MODELO"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="$MODELO"
export ANTHROPIC_SMALL_FAST_MODEL="$MODELO"                   # la fuga clásica: tareas de fondo del arnés.
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1             # aprobado por el Soberano (Bloque 12).

# Bandera que lee CLAUDE.md para saber qué cerebro manda en esta sesión.
export P0X_BRAIN=local

# --- Banner inequívoco -----------------------------------------------------
printf '\n'
printf '  ╔══════════════════════════════════════════════════════════╗\n'
printf '  ║  P0X · CEREBRO LOCAL                                     ║\n'
printf '  ╠══════════════════════════════════════════════════════════╣\n'
printf '  ║  cerebro   : local (P0X_BRAIN=local)                     ║\n'
printf '  ║  modelo    : %-44s║\n' "$MODELO_TXT"
printf '  ║  num_ctx   : %-44s║\n' "$CTX_TXT"
printf '  ║  backend   : %-44s║\n' "$BACKEND"
printf '  ║  endpoint  : POST /v1/messages (Anthropic nativo)        ║\n'
printf '  ╠══════════════════════════════════════════════════════════╣\n'
printf '  ║  SIN TOKEN DE FRONTERA                                   ║\n'
printf '  ╠══════════════════════════════════════════════════════════╣\n'
printf '  ║  SERVIDOR EFÍMERO: no hay unidad que lo resucite. Si     ║\n'
printf '  ║  muere, relanzarlo con:                                  ║\n'
printf '  ║    deploy/soberano/cerebro-local-arranca.sh              ║\n'
printf '  ╠══════════════════════════════════════════════════════════╣\n'
printf '  ║  NO toca canon · NO enmienda doctrina · NO emite         ║\n'
printf '  ║  veredictos de arquitectura · NO decide pedagogía.       ║\n'
printf '  ║  Inventarios, tests, refactors mecánicos y diffs.        ║\n'
printf '  ║  Todo pasa el gate (tsc=0 + tests) antes de existir.     ║\n'
printf '  ╚══════════════════════════════════════════════════════════╝\n'
printf '\n  Al cerrar: anota la sesión en mente/telemetria/cerebro_local.jsonl\n\n'

# --- Herramienta excluida por DATO, no por gusto ---------------------------
# MEDIDO (2026-08-04): llama-server aborta con
#   400 "Failed to initialize samplers: failed to parse grammar"
# ante CUALQUIER petición del arnés. Bisecado hasta la causa raíz: la conversión
# JSON-Schema→GBNF de llama.cpp expande `maxLength` a una gramática de repetición
# explícita, y revienta entre 1024 y 16384 (medido: 1024 ok, 16384 falla). La
# herramienta `Workflow` declara `script.maxLength = 524288`, así que envenena
# el payload entero: sin excluirla, el cerebro local NO ARRANCA.
# Excluirla quita la única propiedad con maxLength>1024 de las 24 herramientas.
# Revisar si se actualiza llama.cpp o cambia el esquema de Workflow.
exec claude --disallowedTools Workflow "$@"
