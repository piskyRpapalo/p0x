#!/usr/bin/env bash
# preview-web · sirve preceptoros-web/public en local, y se recoge la mesa.
#
# POR QUE EXISTE
# --------------
# El 2026-08-30 el Ojo destapo DIEZ `python3 -m http.server` huerfanos en los
# puertos 8792-8808, sirviendo esta misma carpeta, reparentados a systemd
# porque su shell habia muerto. El mas viejo llevaba siete horas. Uno por
# sesion: cada una levantaba su previsualizacion y ninguna la apagaba.
#
# Es el «servicio fantasma» del canon por la puerta de atras -- sin unidad, sin
# firma y sin registro. Nadie lo sabia porque estaban en loopback y porque
# nadie mira `ss` entero.
#
# Este guion arregla las tres causas:
#   * PUERTO FIJO. Uno, no uno nuevo por sesion.
#   * FICHERO DE PID. Antes de arrancar, mata el suyo anterior si sigue vivo.
#   * --stop. Apagarlo es un comando, no un arqueo de procesos.
#
# Y se ata a 127.0.0.1 explicitamente: el `:8080` de aquel dia estaba en
# 0.0.0.0, sin auth y sin logs, expuesto a la red entera.
set -uo pipefail

PUERTO="${PUERTO_PREVIEW:-8791}"
DIR="$HOME/preceptoros-web/public"
PIDF="${XDG_RUNTIME_DIR:-/tmp}/p0x-preview-web.pid"

matar_anterior () {
  [ -f "$PIDF" ] || return 0
  local viejo; viejo="$(cat "$PIDF" 2>/dev/null || true)"
  if [ -n "$viejo" ] && kill -0 "$viejo" 2>/dev/null; then
    # Se comprueba que el PID sea NUESTRO antes de matarlo. Un fichero de pid
    # rancio puede apuntar a un proceso que reuso ese numero, y matar a ciegas
    # por un pid reciclado es peor que dejar una preview colgada.
    if tr '\0' ' ' < "/proc/$viejo/cmdline" 2>/dev/null | grep -q "http.server $PUERTO"; then
      kill "$viejo" && echo "· preview anterior (pid $viejo) apagada"
      sleep 0.4
    fi
  fi
  rm -f "$PIDF"
}

if [ "${1:-}" = "--stop" ]; then
  matar_anterior
  echo "✅ preview detenida"
  exit 0
fi

if [ ! -d "$DIR" ]; then
  echo "🔴 NO_DATA: no existe $DIR" >&2
  exit 1
fi

matar_anterior
cd "$DIR"
setsid python3 -m http.server "$PUERTO" --bind 127.0.0.1 >/dev/null 2>&1 < /dev/null &
echo $! > "$PIDF"
sleep 0.6

# Se comprueba que responde EL NUESTRO, no que responde alguien.
#
# La version anterior hacia `curl` al puerto y daba verde si contestaba algo.
# Medido el 2026-08-30: habia otro `http.server` ajeno ocupando el 8791 desde
# hacia media hora, sirviendo OTRA carpeta. El nuestro no pudo enlazar y murio;
# el curl contesto 200 desde el intruso, y el guion anuncio exito. Media hora
# de verificaciones habrian sido contra la carpeta equivocada.
#
# Es el mismo error que se corrigio esta sesion en el recolector y en el
# guardian: comprobar la propiedad que no informa.
MIO="$(cat "$PIDF" 2>/dev/null)"
DUENO="$(ss -tlnpH 2>/dev/null | grep "127.0.0.1:$PUERTO" | grep -oP 'pid=\K[0-9]+' | head -1)"

if [ -z "$DUENO" ]; then
  echo "🔴 nadie escucha en :$PUERTO — el servidor no arrancó" >&2
  exit 1
fi
if [ "$DUENO" != "$MIO" ]; then
  echo "🔴 el puerto :$PUERTO lo ocupa OTRO proceso (pid $DUENO), no el nuestro:" >&2
  tr '\0' ' ' < "/proc/$DUENO/cmdline" 2>/dev/null | sed 's/^/     /' >&2; echo >&2
  echo "     sirviendo: $(readlink "/proc/$DUENO/cwd" 2>/dev/null)" >&2
  echo "     Remedio: PUERTO_PREVIEW=8793 ~/p0x/bin/preview-web   (o apagar ese)" >&2
  rm -f "$PIDF"
  exit 1
fi
if ! curl -s -o /dev/null --max-time 3 "http://127.0.0.1:$PUERTO/"; then
  echo "🔴 el nuestro enlazó el puerto pero no responde" >&2
  exit 1
fi
echo "✅ http://127.0.0.1:$PUERTO/   (pid $MIO · $DIR)"
echo "   apagar: ~/p0x/bin/preview-web --stop"
