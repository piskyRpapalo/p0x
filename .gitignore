# derivados ligeros pero 100% regenerables desde el corpus .md ya versionado —
# trackearlos solo crea diffs de ruido en cada ingesta, sin historia nueva real
# (mismo criterio ya usado en el repo hexelion con disk_nodes.json/vessel_db.sqlite)
mente/grafo/second_brain.json
mente/pipeline/.ingest_manifest.json

# transcripciones de builds manuales puntuales (jun-2026, whisper.cpp bootstrap) —
# log de una corrida, no fuente ni configuración
pipeline_build*.log

# telemetría viva del Sínodo (Bloque T): dato operativo append-only, no fuente —
# se versiona el README del directorio, jamás el jsonl (crecería sin historia real)
mente/telemetria/*.jsonl

# auditoría: el informe AUDIT_*.md se versiona (registro); la evidencia
# cruda out/*.json es runtime regenerable en cada corrida
mente/auditorias/out/

# jobs OBSERVAR: estado operativo runtime (state.json, runner.log, checkpoints
# de fase) — el resultado curado entra a mente/ al ACEPTAR y el descarte queda
# versionado en mente/necropolis/ (sin su .lock, que es artefacto de flock)
pipeline/observar/
mente/necropolis/**/.lock

# corpus: solo se trackea el resultado curado (transcript.*, meta.tsv). El audio
# crudo bajado (webm) y el volcado de metadata de yt-dlp (info.json, listas de
# formatos/thumbnails, no contenido) son artefactos de la descarga, no fuente.
corpus/**/audio.webm
corpus/**/audio.info.json

# Gate 0 voz: venv y modelos .onnx descargables (HuggingFace) — regenerables
# con voz/gate0_sintesis.sh; solo se versiona script + métricas + veredictos
voz/.venv-piper/
voz/modelos/
voz/cache/

# diario verde: fotos 100% locales del rack (invariante fotos-locales: jamás
# se pushean, ni siquiera al bare soberano) + diario.jsonl operativo
# append-only; se versiona solo el README con el esquema
verde/fotos/
verde/diario.jsonl

# cuaderno de /indoor: notas personales de la familia (dato personal, invariante
# fotos-locales extendido) — backup local en .backups/, jamás versionado
verde/cuaderno.md

