# EL NEXO · configuracion de esta instalacion.
#
# Copia a `.env` y ajusta. `.env` esta en .gitignore y NO se versiona: lo que
# hay aqui son nombres de maquina y de red, y lo que entra en la historia de un
# repo no se saca sin reescribirla.
#
# Todo esto es OPCIONAL. Sin nada de ello el panel arranca igual y las tarjetas
# que dependan de lo que falte dicen NO_DATA con su causa, que es el
# comportamiento correcto y no un modo degradado.

# Donde vive el gateway que publica las sondas profundas de nodo.
# Nombre de MagicDNS o de DNS normal, nunca una direccion.
NEXO_GATEWAY=http://mi-gateway:8001

# Cual de los nodos de rack.conf es ESTA maquina. Es el unico del que se sabe
# algo de primera mano, y por eso el unico que puede corregir lo que diga un
# registro remoto sobre si esta en pie.
NEXO_NODO_PROPIO=mi-nodo

# La ventana del cielo: `lat_sur,lat_norte,lon_oeste,lon_este`. Sin declararla
# se deduce de lo que hay, con un suelo de tamaño -- lo que impide que dos
# aviones cercanos se pinten en esquinas opuestas. Declararla es mejor: la
# escala deja de moverse entre refrescos, y un avion quieto se queda quieto.
NEXO_ADSB_VENTANA=38.0,40.0,-10.0,-8.0

# La camara MJPEG, si la hay. Sin esto el panel no emite ni una etiqueta que
# apunte a ninguna red.
NEXO_CAMARA=http://mi-camara:8080/stream

# La memoria del nucleo, si no vive donde suele.
NEXO_MEMORIA=
