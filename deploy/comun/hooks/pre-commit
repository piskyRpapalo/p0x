#!/usr/bin/env bash
# Guardia de higiene P0X · gancho pre-commit
# Instalado por bin/p0x-instalar-ganchos. Fuente versionada:
#   p0x/deploy/comun/hooks/pre-commit
set -uo pipefail

DIR="$(cd "$(dirname "$0")" && pwd)"
GUARDIA="$DIR/guardia_higiene.py"
PY="$(command -v python3 || echo /usr/bin/python3)"

# UN SOLO COMMITTER A LA VEZ. Firmado el 2026-09-12.
#
# Hoy la disciplina se cumple POR CASUALIDAD: ningun bucle del rack toca git
# --comprobado, cero `git commit` en bucles/, laboratorio/ y scripts/-- asi que
# nunca hay dos a la vez. Pero nadie la IMPONE, y la hoja de ruta lleva a que un
# bucle escriba (datasets de LoRA, cierres automaticos). El dia que eso pase, dos
# commits simultaneos se pelean por `.git/index.lock` y el segundo muere con un
# error que no dice lo que paso.
#
# El cerrojo no prohibe nada: SERIALIZA. El segundo espera su turno en vez de
# reventar, y si espera demasiado lo dice en voz alta en vez de colgarse. Una
# regla que se cumple sola hasta que deja de cumplirse no es una regla: es una
# racha de suerte con buena reputacion.
#
# Medido al instalarlo: con el cerrojo tomado por otro proceso, un commit espero
# 5,0 s y entro. Sin el, habria sido un fallo de `.git/index.lock`.
CERROJO="$(git rev-parse --git-dir)/p0x-commit.lock"
exec 9>"$CERROJO"
if ! flock -w 120 9; then
    echo "❌ BLOQUEADO: otro proceso lleva 120 s commiteando en este repo."
    echo "   Es la guarda de un solo committer. Mira quien es antes de forzar."
    exit 1
fi

echo "=== GUARDIA DE HIGIENE · pre-commit ==="

if [ ! -f "$GUARDIA" ]; then
    echo "❌ BLOQUEADO: falta $GUARDIA (reinstala con p0x-instalar-ganchos)"
    exit 1
fi

EXIT_CODE=0

# 1. Contenido añadido: direcciones, rutas, dominios, claves.
SALIDA="$(git diff --cached -U0 --no-color --diff-filter=ACMR \
          | "$PY" "$GUARDIA" --diff)" || EXIT_CODE=1
if [ -n "$SALIDA" ]; then
    echo "❌ BLOQUEADO: fuga de infraestructura en lo staged"
    echo "$SALIDA"
    EXIT_CODE=1
fi

# 2. Doctrina fuera de p0x: mente/ y doctrina/ solo viven en el repo privado.
REPO="$(basename "$(git rev-parse --show-toplevel)")"
if [ "$REPO" != "p0x" ]; then
    RUTAS="$(git diff --cached --name-only --diff-filter=ACMR \
             | grep -E '(^|/)(mente|doctrina)/' || true)"
    if [ -n "$RUTAS" ]; then
        echo "❌ BLOQUEADO: doctrina fuera de p0x (repo: $REPO)"
        echo "$RUTAS"
        EXIT_CODE=1
    fi
fi

if [ $EXIT_CODE -eq 0 ]; then
    echo "✅ GUARDIA OK"
else
    echo "— Excepción declarada: añade 'guardia:permitir <motivo>' en la línea."
    echo "— Forzar a ciegas: git commit --no-verify (queda sin registrar)."
fi
exit $EXIT_CODE
