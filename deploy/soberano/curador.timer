[Unit]
Description=Curador · semanal

[Timer]
# Domingos a las 05:00: despues del Afinador (03:00) y del Guardian (04:00),
# para que los tres no se peleen por la CPU ni por los 16 GB del modelo.
OnCalendar=Sun *-*-* 05:00:00
RandomizedDelaySec=30min
Persistent=true

[Install]
WantedBy=timers.target
