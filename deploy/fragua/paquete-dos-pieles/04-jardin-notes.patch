+# Le Cahier (Fase 4a, decisión del Preceptor §7.7): la verdad de las notas
+# vive en el rack, no en un perfil de navegador. Persistencia mínima: un JSON
+# por archivo en verde/ — mismo suelo local que el herbier y el diario.
+_JARDIN_NOTES_PATH = _P0X_ROOT / "verde" / "cahier_notes.json"
+_JARDIN_NOTES_LOCK = threading.Lock()
+
+
+class NoteJardin(BaseModel):
+    id: str
+    corps: str
+    titre: str = "Sans titre"
+    fecha: str = ""
+    memoire: bool = False
+
+
+def _jardin_notes_leer() -> list:
+    try:
+        crudo = json.loads(_JARDIN_NOTES_PATH.read_text(encoding="utf-8"))
+        return crudo if isinstance(crudo, list) else []
+    except (OSError, ValueError):
+        return []
+
+
+@app.get("/api/jardin/notes")
+def jardin_notes_get():
+    """Las notas del Cahier, más nueva primero. Vacío honesto si aún no hay."""
+    notas = sorted(_jardin_notes_leer(), key=lambda n: n.get("fecha", ""),
+                   reverse=True)
+    return {"notes": notas, "total": len(notas),
+            "fuente": "verde/cahier_notes.json (100% local)"}
+
+
+@app.post("/api/jardin/notes")
+def jardin_notes_post(nota: NoteJardin):
+    """`Garder`: upsert por id. El campo `sincronizada` es del cliente y no
+    se persiste — aquí toda nota guardada ES la verdad del rack."""
+    with _JARDIN_NOTES_LOCK:
+        notas = [n for n in _jardin_notes_leer() if n.get("id") != nota.id]
+        notas.append({"id": nota.id, "titre": nota.titre, "corps": nota.corps,
+                      "fecha": nota.fecha, "memoire": nota.memoire})
+        _JARDIN_NOTES_PATH.parent.mkdir(parents=True, exist_ok=True)
+        tmp = _JARDIN_NOTES_PATH.with_suffix(".json.tmp")
+        tmp.write_text(json.dumps(notas, ensure_ascii=False, indent=1),
+                       encoding="utf-8")
+        tmp.replace(_JARDIN_NOTES_PATH)
+    return {"ok": True, "total": len(notas)}
+
+
