+# ── LAS DOS PIELES (Fase 5) ─────────────────────────────────────────────────
+# Build MPA único (base /ui/): Nexo (index.html, EN), Jardin (jardin.html, FR)
+# y Bandeja (tray.html, EN) en un solo dist VERSIONADO en el repo
+# (dashboard/dist) — deploy = git pull + restart, sin scp ni builds en fragua.
+# El swap de la cara visible es OPT-IN por env UI_CARA=dos-pieles (invariante
+# de la misión: backup + Playwright verde antes del swap; sin la env, todo lo
+# legado sigue intacto y las pieles nuevas se prueban en /ui/).
+UI_DIST = os.environ.get(
+    "UI_DIST", str(Path(__file__).resolve().parent / "dashboard" / "dist"))
+DOS_PIELES = os.environ.get("UI_CARA", "") == "dos-pieles"
+app.mount("/ui", StaticFiles(directory=UI_DIST, html=True, check_dir=False),
+          name="ui")
+if not DOS_PIELES:
+    # Le Jardin des Ombres v1 (legado): build Vite estático (base '/jardin/')
+    # desde ~/jardin-des-ombres. check_dir=False: si el dist no existe el
+    # gateway arranca igual (404 honesto en /jardin). Con el swap activado el
+    # mount cede el sitio al alias FileResponse del build nuevo (más abajo).
+    app.mount("/jardin",
+              StaticFiles(directory=os.environ.get(
+                              "JARDIN_DIST", "/home/ubuntu/jardin-des-ombres/dist"),
+                          html=True, check_dir=False), name="jardin")
