# ─────────────────────────────────────────────────────────────────────────────
# PROPUESTA — NO HABILITADA (propose-only, IronClaw).
# El silicio NO instala ni habilita servicios persistentes: veto del clasificador.
# Para activar (decisión del Soberano):
#   sudo cp deploy/fragua/reflejo-bateria.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now reflejo-bateria
# Verificar antes: python3 deploy/fragua/reflejo_bateria_watch.py --once
# Doctrina: mente/reflejos/reflejo-bateria.md
# ─────────────────────────────────────────────────────────────────────────────
[Unit]
Description=P0X Reflejo-1 (reflejo-bateria) - UPS OB/LB pausa la cola batch (sin LLM en el lazo)
After=nut-monitor.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
# ~/.local/bin al PATH: el server tsp y upsc se resuelven aun sin PATH interactivo
Environment=PATH=/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 /mnt/nvme/p0x/deploy/fragua/reflejo_bateria_watch.py
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
