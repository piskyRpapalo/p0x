# ─────────────────────────────────────────────────────────────────────────────
# PROPUESTA — NO HABILITADA (propose-only, IronClaw). Para activar (Soberano):
#   sudo cp deploy/fragua/reflejo-m5.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now reflejo-m5
# Verificar antes: python3 deploy/fragua/reflejo_m5_watch.py --once
# Doctrina: mente/reflejos/reflejo-termico-m5.md · reflejo-vibracion.md
# ─────────────────────────────────────────────────────────────────────────────
[Unit]
Description=P0X Reflejos 2+3 (termico-m5 + vibracion) - avisos deterministas del M5, sin LLM
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Environment=PATH=/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 /mnt/nvme/p0x/deploy/fragua/reflejo_m5_watch.py
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
