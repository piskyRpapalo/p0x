[Unit]
Description=retencion de .backups/ (#60): conserva N=200 por prefijo o <60 dias
# PROPUESTO — no instalado en /etc/systemd, no habilitado. Instalar con:
#   sudo cp deploy/fragua/prune-backups.{service,timer} /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now prune-backups.timer

[Service]
Type=oneshot
# --apply borra de verdad; sin --apply seria dry-run. Politica generosa (keep=200/60d).
ExecStart=/usr/bin/python3 /mnt/nvme/p0x/bin/prune_backups.py --apply
User=ubuntu
