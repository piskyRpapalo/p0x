[Unit]
Description=El Agora · /api/v1 de PreceptorOS en 127.0.0.1:9002
Documentation=file://%h/agora/README.md
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/agora
# La IP de la Ollama del Soberano NO se escribe aqui: este fichero vive en un
# repo con remoto publico y la guardia de higiene marca [IP-TAILNET], una
# regla que ni `guardia:permitir` exime. Va en un fichero del NODO, que es
# donde esa direccion es un dato de infraestructura y no una fuga.
#
#   ~/.config/agora.env   ->   OLLAMA_HOST=http://<ip-tailnet-soberano>:11434
#
# El `-` inicial hace que la unidad arranque aunque el fichero falte: sin
# OLLAMA_HOST el proxy contesta 503 con su causa, y los perfiles y el tablon
# siguen sirviendo. Un Agora entero caido porque falta el chat seria peor.
#
# AGORA_DATOS va en el MISMO fichero del nodo, y por la misma razon: es una
# ruta absoluta de `la-fragua` y la guardia la marca [RUTA-HOME]. El defecto
# que trae `agora_api.py` ya es el correcto para ese nodo, asi que omitirla
# aqui no cambia nada; escribirla si habria sido una fuga.
#
#   ~/.config/agora.env   ->   AGORA_DATOS=<el NVMe de la-fragua>
EnvironmentFile=-%h/.config/agora.env
ExecStart=%h/venvs/agora/bin/uvicorn agora_api:app --host 127.0.0.1 --port 9002
Restart=on-failure
RestartSec=10
# Escucha en loopback y al exterior solo sale por el tunel: se le da lo justo.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
